    }
   ]
  },
  {
   "title": "Dark and bright colors",
   "blocks": [
    {
     "type": "p",
     "t": "For darker, solid or brilliant shades, **say the color twice**, joined by the ligature **na** or **-ng** (Lesson 7)."
    },
    {
     "type": "pattern",
     "title": "color + na / -ng + color",
     "rows": [
      {
       "label": "na",
       "chips": [
        {
         "t": "asúl",
         "r": "pred"
        },
        {
         "t": "na",
         "r": "link"
        },
        {
         "t": "asúl",
         "r": "pred"
        }
       ]
      },
      {
       "label": "-ng",
       "chips": [
        {
         "t": "bérde",
         "r": "pred"
        },
        {
