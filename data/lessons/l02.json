  {
   "title": "Fact 1: stress can change the meaning",
   "blocks": [
    {
     "type": "p",
     "t": "Words spelled with the same letters can mean different things. Only the stress tells them apart."
    },
    {
     "type": "table",
     "head": [
      "Word",
      "Sound guide",
      "Meaning"
     ],
     "rows": [
      [
       "[[kaibígan|noun]]",
       "ka-i-BI-gan",
       "friend"
      ],
      [
       "[[kaibigán|noun]]",
       "ka-i-bi-GAN",
       "desire"
      ],
      [
       "[[káibigán|pred]]",
       "KA-i-bi-GAN",
       "have mutual understanding with"
      ],
      [
       "[[kaíbigan|noun]]",
       "ka-I-bi-gan",
       "sweetheart"
      ],
