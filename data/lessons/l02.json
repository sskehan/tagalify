      ]
     ],
     "title": "Same letters, different words"
    },
    {
     "type": "box",
     "kind": "warn",
     "title": "Learn the stress with the word",
     "t": "Wrong stress can turn \"friend\" into \"sweetheart\". Always learn a word together with its stress."
    }
   ]
  },
