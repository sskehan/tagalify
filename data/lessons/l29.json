    {
     "type": "table",
     "head": [
      "#",
      "English",
      "Word to use"
     ],
     "rows": [
      [
       "1",
       "We shall study Tagalog if you like.",
       "kung or kapág (if, future)"
      ],
      [
       "2",
       "We shall study Tagalog when you like to.",
       "kung or kapág (future)"
      ],
      [
