 "exercises": [
  {
   "type": "choice",
   "q": "Are plural verbs compulsory with plural subjects?",
   "options": [
    "No: a singular verb with a plural subject is not wrong",
    "Yes: a singular verb is always wrong",
    "Only in questions"
   ],
   "answer": "No: a singular verb with a plural subject is not wrong",
   "explain": "Lope K. Santos's grammar says plural verbs are not compulsory."
  },
  {
   "type": "choice",
   "q": "Which prefix makes the plural of -um- verbs?",
   "options": [
    "magsi-",
    "magsipag-",
    "pag- + -an"
   ],
   "answer": "magsi-",
   "explain": "kumain → magsikáin."
  },
  {
   "type": "choice",
   "q": "Which prefix makes the plural of mag- verbs?",
   "options": [
    "magsipag-",
    "magsi-",
    "pag- + -in"
   ],
   "answer": "magsipag-",
   "explain": "maglakád → magsipaglakád."
  },
  {
   "type": "choice",
   "q": "Pag- + -in is the plural of which verb type?",
   "options": [
    "-in verbs",
    "-um- verbs",
    "mag- verbs"
   ],
   "answer": "-in verbs",
   "explain": "pagsulatín, paglutuín."
  },
  {
   "type": "choice",
   "q": "Pag- + -an is the plural of which verb type?",
   "options": [
    "-an verbs",
    "-in verbs",
    "-um- verbs"
   ],
   "answer": "-an verbs",
   "explain": "paghuhugasán, pagbubuksán."
  },
  {
   "type": "choice",
   "q": "What is the past tense of magsikáin?",
   "options": [
    "nagsikáin",
    "nagsísikáin",
    "magsísikáin"
   ],
   "answer": "nagsikáin",
   "explain": "magsi- becomes nagsi-."
  },
  {
   "type": "choice",
   "q": "Nagsísialís means…",
   "options": [
    "are leaving",
    "left",
    "will leave"
   ],
   "answer": "are leaving",
   "explain": "nagsi- + repeated si + root = present."
  },
  {
   "type": "choice",
   "q": "Magsísipaglakád means…",
   "options": [
    "will walk",
    "walked",
    "are walking"
   ],
   "answer": "will walk",
   "explain": "magsipag- with si repeated = future."
  },
  {
   "type": "choice",
   "q": "Why is there a hyphen in magsipag-áral?",
   "options": [
    "The root starts with a vowel",
    "It is the past tense",
    "It is a passive verb"
   ],
   "answer": "The root starts with a vowel",
   "explain": "Also magsipag-akyát."
  },
  {
   "type": "choice",
   "q": "Which syllable is repeated in the present and future of magsi- and magsipag- verbs?",
   "options": [
    "si, from the prefix",
    "the first syllable of the root",
    "pag"
   ],
   "answer": "si, from the prefix",
   "explain": "nagsísikáin, magsísipaglakád."
  },
  {
   "type": "choice",
   "q": "Pinaglutò means…",
   "options": [
    "were cooked",
    "are being cooked",
    "will be cooked"
   ],
   "answer": "were cooked",
   "explain": "-in- after the p of pag- + root."
  },
  {
   "type": "choice",
   "q": "Why does lutò become paglutuín?",
   "options": [
    "A root ending in o changes it to u before the -in ending",
    "Because it is irregular",
    "Because it is the past tense"
   ],
   "answer": "A root ending in o changes it to u before the -in ending",
   "explain": "Also paglúlutuín."
  },
  {
   "type": "choice",
   "q": "Which is the future of pagsulatín?",
   "options": [
    "pagsúsulatín",
    "pinagsusulát",
    "pinagsulát"
