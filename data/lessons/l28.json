 "exercises": [
  {
   "type": "choice",
   "q": "How do you ask \"What time is it?\"",
   "options": [
    "Anóng oras na?",
    "Anóng áraw búkas?",
    "Kailán ka áalis?"
   ],
   "answer": "Anóng oras na?",
   "explain": "Tagalogs often ask strangers this."
  },
  {
   "type": "choice",
   "q": "To tell time, which prefix goes before the cardinal numbers?",
   "options": [
    "ika-",
    "mag-",
    "ma-"
   ],
   "answer": "ika-",
   "explain": "ikalawá, ikatló, ika-ápat…"
  },
  {
   "type": "choice",
   "q": "How does the book say 1:00 a.m.?",
   "options": [
    "unang oras ng umaga",
    "ikalawá ng umaga",
    "ikatló ng umaga"
   ],
   "answer": "unang oras ng umaga",
   "explain": "One o'clock is the first hour: unang oras."
  },
  {
   "type": "choice",
   "q": "Tell 8:00 p.m. in Tagalog.",
   "options": [
    "ikawaló ng gabí",
    "ikawaló ng umaga",
    "ikapitó ng gabí"
   ],
   "answer": "ikawaló ng gabí",
   "explain": "From the table: 8:00 p.m. = ikawaló ng gabí (a las otso ng gabí)."
  },
  {
   "type": "choice",
   "q": "Tell 10:00 a.m. in Tagalog.",
   "options": [
    "ikasampû ng umaga",
    "ikasampû ng gabí",
    "ikasiyám ng umaga"
   ],
   "answer": "ikasampû ng umaga",
   "explain": "Spanish: a las diyes ng umaga."
  },
  {
   "type": "choice",
   "q": "Tell 6:00 a.m. in Tagalog.",
   "options": [
    "ikaánim ng umaga",
    "ikaánim ng gabí",
    "ikalimá ng umaga"
   ],
   "answer": "ikaánim ng umaga",
   "explain": "Spanish: a las seis ng umaga."
  },
  {
   "type": "choice",
   "q": "Tell 12:00 midnight in Tagalog.",
   "options": [
    "ikalabíndalawá ng hátinggabí",
    "ikalabindalawá ng tánghali",
    "ikalabíng-isá ng gabí"
   ],
   "answer": "ikalabíndalawá ng hátinggabí",
   "explain": "Hátinggabí means midnight."
  },
  {
   "type": "choice",
   "q": "What is 3:30 p.m. the Spanish way?",
   "options": [
    "a las tres y medya ng hápon",
    "a las tres ng umaga",
    "a las sinko y kuwarto ng hápon"
   ],
   "answer": "a las tres y medya ng hápon",
   "explain": "In Tagalog: ikatló at kalahatí ng hápon."
  },
  {
   "type": "choice",
   "q": "\"ikalimá at labinlimang minuto ng hápon\" is…",
   "options": [
    "5:15 p.m.",
    "5:00 a.m.",
    "6:40 p.m."
   ],
   "answer": "5:15 p.m.",
   "explain": "Five and fifteen minutes in the afternoon."
  },
  {
   "type": "choice",
   "q": "What does n.u. stand for?",
   "options": [
    "ng umaga, a.m.",
    "ng hápon, p.m.",
    "ng gabí, evening"
   ],
   "answer": "ng umaga, a.m.",
   "explain": "n.u. = ng umaga."
  },
  {
   "type": "choice",
   "q": "What does n.t. stand for?",
