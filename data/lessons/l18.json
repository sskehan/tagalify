 "exercises": [
  {
   "type": "choice",
   "q": "In general, what does a verb with ma- show?",
   "options": [
    "capability to do something",
    "an order",
    "an action that is finished"
   ],
   "answer": "capability to do something",
   "explain": "In general, a ma- verb indicates capability to do something."
  },
  {
   "type": "choice",
   "q": "A ma- verb made from an INTRANSITIVE verb is…",
   "options": [
    "active",
    "passive",
    "always an imperative"
   ],
   "answer": "active",
   "explain": "It takes a noun or a nominative pronoun (siyá, ikáw) as its subject."
  },
  {
   "type": "choice",
   "q": "A ma- verb made from a TRANSITIVE verb is…",
   "options": [
    "passive",
    "active",
    "never used in the past"
   ],
   "answer": "passive",
   "explain": "It needs a subject in the possessive form, such as niyá or mo."
  },
  {
   "type": "choice",
   "q": "Which is always active?",
   "options": [
    "maka-",
    "transitive ma-",
    "both"
   ],
   "answer": "maka-",
   "explain": "Maka- is always active and takes a nominative subject such as siyá or ikáw."
  },
  {
   "type": "choice",
   "q": "Why is there no maka- form of magálit (to be angry)?",
   "options": [
    "Maka- is only formed from verbs showing action",
    "Magálit is transitive",
    "Maka- has no past tense"
   ],
   "answer": "Maka- is only formed from verbs showing action",
   "explain": "Ma- can be formed from verbs of emotion or feeling; maka- cannot."
  },
  {
   "type": "choice",
   "q": "What is the past of matúlog?",
   "options": [
    "natúlog",
    "natútulog",
    "matútulog"
   ],
   "answer": "natúlog",
   "explain": "Ma- becomes na- + root."
  },
  {
   "type": "choice",
   "q": "What is the present of matúlog?",
   "options": [
    "natútulog",
    "natúlog",
    "matútulog"
   ],
   "answer": "natútulog",
   "explain": "Ma- becomes na-, and the first syllable of the root is repeated."
  },
  {
   "type": "choice",
   "q": "What is the future of matúlog?",
   "options": [
    "matútulog",
    "natútulog",
    "makatúlog"
   ],
   "answer": "matútulog",
   "explain": "Ma- + duplicated first syllable + root."
  },
  {
   "type": "choice",
   "q": "Which verb form has NO imperative?",
   "options": [
    "a transitive ma- verb such as mákita",
    "an intransitive ma- verb such as matúlog"
   ],
   "answer": "a transitive ma- verb such as mákita",
   "explain": "Transitive ma- verbs and maka- verbs have no imperative."
  },
  {
   "type": "choice",
   "q": "What does nakatúlog mean?",
   "options": [
    "was/were able to sleep",
    "will be able to sleep",
    "slept unintentionally"
   ],
   "answer": "was/were able to sleep",
   "explain": "Maka- becomes naka- + root in the past."
  },
  {
   "type": "choice",
   "q": "\"Hindi ako ___ kung malamíg.\" (I cannot take a bath when it is cold.)",
   "options": [
    "makaligò",
    "maligò",
    "nakaligò"
   ],
   "answer": "makaligò",
   "explain": "Maka- shows the ability to do something."
  },
  {
   "type": "choice",
   "q": "In \"Nákíta ko si Mary\", why is the doer ko and not ako?",
   "options": [
    "Transitive ma- verbs take a subject in the possessive form",
    "Ko is plural",
    "Ako is only used in questions"
   ],
   "answer": "Transitive ma- verbs take a subject in the possessive form",
   "explain": "Like -in- verbs, a transitive ma- verb is passive."
  },
  {
   "type": "choice",
   "q": "Stressed má- and maká- express…",
   "options": [
    "unintentional or accidental actions",
    "commands",
    "actions done every day"
   ],
   "answer": "unintentional or accidental actions",
   "explain": "The act is beyond the control of the doer or the receiver."
  },
  {
   "type": "choice",
   "q": "In stressed maká- verbs, what is repeated in the present and future?",
   "options": [
    "ka, the second syllable of the prefix",
    "the first syllable of the root",
    "nothing"
   ],
   "answer": "ka, the second syllable of the prefix",
   "explain": "Nakákatulog, makákatulog."
  },
  {
   "type": "choice",
   "q": "What is the present of makátulog (to sleep unintentionally)?",
   "options": [
    "nakákatulog",
    "nakátulog",
    "nakatútulog"
   ],
   "answer": "nakákatulog",
   "explain": "Maká- becomes naká- + duplicated ka + root."
  },
  {
   "type": "choice",
   "q": "\"Nakápulot ang batà ng sampûng píso\" means…",
   "options": [
    "The child (by chance) picked up ten pesos.",
    "The child will pick up ten pesos.",
    "The child was able to buy ten pesos."
   ],
   "answer": "The child (by chance) picked up ten pesos.",
   "explain": "Nakápulot: picked up, by accident."
  },
  {
   "type": "listen",
   "tl": "makatúlog",
   "options": [
    "to be able to sleep",
    "to sleep unintentionally",
    "slept"
