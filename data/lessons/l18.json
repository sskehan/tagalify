       "[[tulog|pred]]",
       "",
       "sleep"
      ],
      [
       "Infinitive",
       "[[mátulog|pred]]",
       "má + root",
       "to sleep unintentionally"
      ],
      [
       "Imperative",
       "none",
       "",
       ""
      ],
      [
       "Past",
       "[[nátulog|pred]]",
       "má- becomes ná- + root",
       "slept unintentionally"
      ],
      [
       "Present",
       "[[nátutulog|pred]]",
       "má- becomes ná- + duplicated first syllable + root",
       "sleeps unintentionally"
