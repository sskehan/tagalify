         "r": "link"
        },
        {
         "t": "arálin",
         "r": "pred"
        },
        {
         "t": "ang Tagálog",
         "r": "noun"
        }
       ]
      }
     ],
     "note": "Both mean: I want to learn Tagalog."
    },
    {
     "type": "table",
     "head": [
      "",
      "Sentence"
     ],
     "rows": [
      [
       "Correct",
       "Ibig **kong** mag-áral ng Tagálog.  (*I want to learn Tagalog.*)"
