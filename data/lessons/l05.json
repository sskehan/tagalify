 "exercises": [
  {
   "type": "choice",
   "q": "Which order is more common in everyday speech?",
   "options": [
    "Predicate first",
    "Subject first with ay"
   ],
   "answer": "Predicate first",
   "explain": "Everyday Tagalog usually starts with the predicate."
  },
  {
   "type": "choice",
   "q": "Flip this sentence: Ang bata ay mabait.",
   "options": [
    "Mabait ang bata.",
    "Mabait ay ang bata.",
    "Ang mabait bata."
   ],
   "answer": "Mabait ang bata.",
   "explain": "Move the predicate to the front and drop ay."
  },
  {
   "type": "choice",
   "q": "Flip this sentence: Si Ana ay maganda.",
   "options": [
    "Maganda si Ana.",
    "Maganda ay si Ana.",
    "Si maganda Ana."
   ],
   "answer": "Maganda si Ana.",
   "explain": "The marker si stays with Ana."
  },
  {
   "type": "choice",
   "q": "Which sentence uses the subject-first order?",
   "options": [
    "Si Ben ay mabait.",
    "Mabait si Ben.",
    "Mainit ang kape."
   ],
   "answer": "Si Ben ay mabait.",
   "explain": "It contains ay between the subject and the predicate."
  },
  {
   "type": "choice",
   "q": "What happens to ay when the predicate moves to the front?",
   "options": [
    "It is deleted",
    "It moves to the end",
    "It becomes sina"
   ],
   "answer": "It is deleted",
   "explain": "Ay only appears in the subject-first order."
  },
  {
   "type": "choice",
   "q": "In \"Mga bata sina Ana at Ben\", what does the sentence mean?",
   "options": [
    "Ana and Ben are children.",
    "The children are Ana and Ben's.",
    "Ana and Ben like children."
   ],
   "answer": "Ana and Ben are children.",
   "explain": "Mga bata is the predicate: children."
  },
  {
   "type": "choice",
   "q": "At the start of a flipped sentence with a plural predicate, use…",
   "options": [
    "mga",
    "ang mga",
    "sina"
   ],
   "answer": "mga",
   "explain": "Mga alone, not ang mga, goes before the plural predicate."
  },
  {
   "type": "choice",
   "q": "How can \"at\" be shortened after a word ending in a vowel?",
   "options": [
    "'t",
    "-ng",
    "-y"
   ],
   "answer": "'t",
   "explain": "Aso at pusa becomes aso't pusa."
  },
  {
   "type": "choice",
   "q": "What does the one-word sentence \"Mainit.\" mean?",
   "options": [
    "(It is) hot.",
    "The coffee is hot.",
    "Is it hot?"
   ],
   "answer": "(It is) hot.",
   "explain": "When the subject is obvious, it can be dropped."
  },
  {
   "type": "choice",
   "q": "In which order is the focus on the predicate?",
   "options": [
    "Predicate first",
    "Subject first"
