   "q": "Which pronoun means \"we\" and includes the person you are talking to?",
   "options": [
    "táyo",
    "kamí",
    "silá"
   ],
   "answer": "táyo",
   "explain": "Táyo means you, he/she and I, or you and I."
  },
  {
   "type": "choice",
   "q": "Which pronoun means \"we\" but leaves out the person you are talking to?",
   "options": [
    "kamí",
    "táyo",
