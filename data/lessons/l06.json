  {
   "type": "choice",
   "q": "Kayó ay bumilí ng pagkáin. Akó ay bumilí ng pagkáin. ___'y bumilí ng pagkáin.",
   "options": [
    "Táyo",
    "Silá",
    "Kamí"
   ],
   "answer": "Táyo",
   "explain": "Kayó + akó = you and I, which is táyo."
  },
  {
   "type": "choice",
   "q": "Mabaít ka. Mabaít siyá. Mabaít ___.",
   "options": [
    "kayó",
    "kamí",
    "akó"
   ],
   "answer": "kayó",
   "explain": "You + he/she = you (plural), kayó."
  },
  {
   "type": "choice",
   "q": "Akó'y naniniwála kay Delia. Silá'y naniniwála kay Delia. ___'y naniniwála kay Delia.",
   "options": [
    "Kamí",
    "Táyo",
    "Kayó"
   ],
   "answer": "Kamí",
   "explain": "I + they = we, not including the person spoken to."
  },
  {
