 "exercises": [
  {
   "type": "choice",
   "q": "Which pronoun means \"we\" including the person you are talking to?",
   "options": [
    "tayo",
    "kami",
    "kayo"
   ],
   "answer": "tayo",
   "explain": "Tayo includes the listener."
  },
  {
   "type": "choice",
   "q": "Which pronoun means \"we\" but NOT the person you are talking to?",
   "options": [
    "kami",
    "tayo",
    "sila"
   ],
   "answer": "kami",
   "explain": "Kami leaves the listener out."
  },
  {
   "type": "choice",
   "q": "You are planning a trip with a friend. How do you say \"we are going\"?",
   "options": [
    "tayo",
    "kami",
    "sila"
   ],
   "answer": "tayo",
   "explain": "You and your friend are both included."
  },
  {
   "type": "choice",
   "q": "Which pronoun changes shape after the predicate?",
   "options": [
    "ikaw (becomes ka)",
    "ako",
    "siya"
   ],
   "answer": "ikaw (becomes ka)",
   "explain": "Ikaw is the only one that changes."
  },
