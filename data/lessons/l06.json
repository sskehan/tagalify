       "parts": [
        [
         "Itó'y",
         "this is",
         "pron"
        ],
        [
         "pagkáin",
         "food",
         "pred"
        ]
       ]
      },
      {
       "tl": "Maliít itó.",
       "en": "This is small.",
       "parts": [
        [
         "Maliít",
         "small",
         "pred"
        ],
        [
         "itó",
         "this",
         "pron"
        ]
