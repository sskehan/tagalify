 "exercises": [
  {
   "type": "choice",
   "q": "Fill in the article: ___ Ruth ay babáe.",
   "options": [
    "Si",
    "Sina",
    "Ang"
   ],
   "answer": "Si",
   "explain": "Si goes before the name of one person."
  },
  {
   "type": "choice",
   "q": "Fill in the article: ___ Helen at Tom ay mababaít.",
   "options": [
    "Sina",
    "Si",
    "Ang mga"
   ],
   "answer": "Sina",
   "explain": "Siná goes before the names of two or more persons."
  },
  {
   "type": "choice",
   "q": "Fill in the article: ___ batà ay mabait.",
   "options": [
    "Ang",
    "Si",
    "Sina"
   ],
   "answer": "Ang",
   "explain": "Batà is not a name, so it takes ang."
  },
  {
   "type": "choice",
   "q": "Fill in the articles: ___ áso at ___ batà ay malilínis.",
   "options": [
    "Ang … ang",
    "Si … si",
    "Sina … sina"
   ],
   "answer": "Ang … ang",
   "explain": "Ang goes before each single thing."
  },
  {
   "type": "choice",
   "q": "Fill in the article: ___ Ruth at Peter ay magkapatíd.",
   "options": [
    "Sina",
    "Si",
    "Ang"
   ],
   "answer": "Sina",
   "explain": "Two names take siná."
  },
  {
   "type": "choice",
   "q": "Fill in the article: ___ Amérika at Aprika ay malalakí.",
   "options": [
    "Ang",
    "Si",
    "Sina"
   ],
   "answer": "Ang",
   "explain": "Ang must always go before the name of a place."
  },
  {
   "type": "choice",
   "q": "Fill in: ___ Peter at ___ Ruth ay mababaít at marurúnong.",
   "options": [
    "Si … si",
    "Ang … ang",
    "Sina … sina"
   ],
   "answer": "Si … si",
   "explain": "Each single name takes si."
  },
  {
   "type": "choice",
   "q": "Fill in the article: ___ Helen, Tom, Mary at John ay malilínis.",
   "options": [
    "Sina",
    "Si",
    "Ang mga"
   ],
   "answer": "Sina",
   "explain": "Several names take siná."
  },
  {
   "type": "choice",
   "q": "Fill in: ___ Tom ay mababaít. (Tom and companions are good.)",
   "options": [
    "Sina",
    "Si",
    "Ang"
   ],
   "answer": "Sina",
   "explain": "Siná Tom means Tom and his companions."
  },
  {
   "type": "choice",
   "q": "When does a subject NOT need an article?",
   "options": [
    "In direct conversation and in commands",
    "When it is a place",
    "When it is plural"
   ],
   "answer": "In direct conversation and in commands",
   "explain": "Otherwise every subject is preceded by an article."
  },
  {
   "type": "choice",
   "q": "What does mga mean on its own?",
   "options": [
    "Nothing; it only marks the plural",
    "children",
    "and"
   ],
   "answer": "Nothing; it only marks the plural",
   "explain": "Mga is a plural marker with no meaning on its own, pronounced ma-nga."
  },
  {
   "type": "choice",
   "q": "What is the plural of mabaít (kind)?",
   "options": [
    "mababaít",
    "mabaítbaít",
    "mamabaít"
   ],
   "answer": "mababaít",
   "explain": "Duplicate the first syllable of the root baít: ma + ba + baít."
  },
  {
   "type": "choice",
   "q": "What is the plural of malínis (clean)?",
   "options": [
    "malilínis",
    "malinislínis",
    "mamalínis"
   ],
   "answer": "malilínis",
   "explain": "ma + li + línis."
  },
  {
   "type": "choice",
   "q": "Is it necessary to make both the subject and the predicate plural?",
   "options": [
    "No, it is optional",
    "Yes, always"
   ],
   "answer": "No, it is optional",
   "explain": "Either the subject or the predicate may be made plural."
  },
  {
