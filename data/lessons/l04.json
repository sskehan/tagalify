        ],
        [
         "ang",
         "the",
         "marker"
        ],
        [
         "Cebu",
         "Cebu",
         "noun"
        ],
        [
         "ay",
         "are",
         "ay"
        ],
        [
         "mga",
         "more than one",
         "marker"
        ],
        [
         "lungsod",
         "city",
         "noun"
        ]
       ]
      },
      {
       "tl": "Ang Baguio at Tagaytay ay malalamig.",
       "en": "Baguio and Tagaytay are cool.",
       "parts": [
        [
         "Ang",
         "the",
         "marker"
        ],
        [
         "Baguio",
         "Baguio",
         "noun"
        ],
        [
         "at",
         "and",
         "other"
        ],
        [
         "Tagaytay",
         "Tagaytay",
         "noun"
        ],
        [
         "ay",
         "are",
         "ay"
        ],
        [
         "malalamig",
         "cool (plural)",
         "pred"
        ]
       ]
      }
     ]
    },
    {
     "type": "box",
     "kind": "tip",
     "title": "Dropping the second ang",
     "t": "When two places are joined by **at** (and), you may leave out the second **ang**. Both versions mean the same thing."
    },
    {
     "type": "box",
     "kind": "remember",
     "title": "Remember",
     "items": [
      "Si and sina are for people's names. Ang and ang mga are for things and places.",
      "Mga shows more than one and is said ma-NGA.",
      "Plural describing words usually repeat the first syllable of the root.",
      "Plural marking is optional on either word."
     ]
    }
   ]
  },
