 "exercises": [
  {
   "type": "choice",
   "q": "How many question words does Tagalog have, according to the book?",
   "options": [
    "14",
    "8",
    "10"
   ],
   "answer": "14",
   "explain": "There are 14, covering who, what, which, how, why, when, where and whose."
  },
  {
   "type": "choice",
   "q": "Which word asks \"how\" when the answer is a degree or quality (how large, how far)?",
   "options": [
    "gaáno",
    "paáno",
    "ilán"
   ],
   "answer": "gaáno",
   "explain": "Gaáno kalakí ang Pilipinas? How large is the Philippines?"
  },
  {
   "type": "choice",
   "q": "Which word asks \"how\" when the answer details a process?",
   "options": [
    "paáno",
    "gaáno",
    "bakit"
   ],
   "answer": "paáno",
   "explain": "Paáno mo malaláman? How will you know?"
  },
  {
   "type": "choice",
   "q": "You want to know where your friend is right now. Which word do you use?",
   "options": [
    "nasaán",
    "saán",
    "kailán"
   ],
   "answer": "nasaán",
   "explain": "Nasaán asks for the location of a person or thing: Nasaán siyá?"
  },
  {
   "type": "choice",
   "q": "You want to ask where someone lives (the location of an action). Which word?",
   "options": [
    "saán",
    "nasaán",
    "alín"
   ],
   "answer": "saán",
   "explain": "Saán kayó nakatirá? Where do you live?"
  },
  {
   "type": "choice",
   "q": "Fill in: ___ ang aklát? (How much is the book?)",
   "options": [
    "Magkáno",
    "Ilán",
    "Kaníno"
   ],
   "answer": "Magkáno",
   "explain": "Magkáno means how much."
  },
  {
   "type": "choice",
   "q": "Fill in: ___ ang anák ninyó? (How many children do you have?)",
   "options": [
    "Ilán",
    "Magkáno",
    "Anó"
   ],
   "answer": "Ilán",
   "explain": "Ilán means how many."
  },
  {
   "type": "choice",
   "q": "A question that starts with kaníno is answered with…",
   "options": [
    "a possessive pronoun such as ákin or kanilá",
    "yes or no",
    "a number"
   ],
   "answer": "a possessive pronoun such as ákin or kanilá",
   "explain": "Kaníno means whose."
  },
  {
   "type": "choice",
   "q": "What does \"Sa kaníno iyán?\" mean?",
   "options": [
    "To whom does that belong?",
    "For whom is that?",
    "Who is that?"
   ],
   "answer": "To whom does that belong?",
   "explain": "Sa kaníno means with/to whom; para sa kaníno means for whom."
  },
  {
   "type": "choice",
   "q": "What is the plural of alín?",
   "options": [
    "alín-alín",
    "ali-alín",
    "alu-alín"
   ],
   "answer": "alín-alín",
   "explain": "A two-syllable word is doubled whole."
  },
  {
   "type": "choice",
   "q": "Kaníno has three syllables. What is its plural?",
   "options": [
    "kaní-kanino",
    "kaníno-kaníno",
    "kanu-kaníno"
   ],
   "answer": "kaní-kanino",
   "explain": "With three or more syllables, only the first two syllables are doubled."
  },
  {
   "type": "choice",
   "q": "Why does anó become anu-anó?",
   "options": [
    "The o of the last syllable becomes u in the first half",
    "It has three syllables",
    "It is a short form"
   ],
   "answer": "The o of the last syllable becomes u in the first half",
   "explain": "The same happens in sinu-síno."
  },
  {
   "type": "choice",
   "q": "Which two question words are never doubled?",
   "options": [
    "nasaán and bakit",
    "síno and anó",
    "ilán and magkáno"
   ],
   "answer": "nasaán and bakit",
   "explain": "No one can be in two places at once, and there cannot be more than one explanation for an event."
  },
  {
   "type": "choice",
   "q": "\"Ilán-ilán ang mga anák nilá?\" asks about…",
   "options": [
    "the total number of children of more than one couple or parent",
    "the age of the children",
    "the names of the children"
   ],
   "answer": "the total number of children of more than one couple or parent",
   "explain": "Between those couples, how many children do they have in all?"
  },
  {
