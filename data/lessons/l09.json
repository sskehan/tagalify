    {
     "type": "box",
     "kind": "warn",
     "title": "Rarely used",
     "t": "**Kaí-kailán** is used very little nowadays. It is mostly found in rural Tagalog areas."
    },
    {
     "type": "box",
     "kind": "rule",
     "title": "Never doubled",
     "t": "**Nasaán** and **bakit** are never doubled. Nothing and no one can be in more than one place at the same time, and there cannot be more than one explanation for an event or action."
    }
