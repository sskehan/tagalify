    {
     "type": "h",
     "t": "Answering kaníno"
    },
    {
     "type": "p",
     "t": "Questions beginning with **kaníno** (*whose*) need answers that point to a possessive pronoun from Lesson 8, such as [[ákin|poss]] (*mine*), [[kaniyá|poss]] (*his or her*), [[kanilá|poss]] (*their*) or another possessive pronoun."
    },
    {
     "type": "box",
     "kind": "remember",
     "title": "Remember",
     "items": [
      "Gaáno asks about degree or quality; paáno asks about a process.",
      "Nasaán asks where a person or thing is; saán asks where an action happens.",
      "Kaníno (whose) is answered with a possessive pronoun such as ákin, kaniyá or kanilá."
     ]
    }
   ]
