{
 "id": "l09",
 "label": "9",
 "title": "Asking questions",
 "summary": "The 14 question words, their plural forms, short forms like 'yan and 'to, and everyday questions",
 "minutes": 35,
 "goals": [
  "Know the 14 Tagalog question words (síno, anó, alín, gaáno, paáno…)",
  "Choose between the two words for how and the two words for where",
  "Make the plural form of a question word by doubling it",
  "Use the shortened forms 'yan and 'to and the ligature in questions",
  "Memorise a set of common everyday questions"
 ],
