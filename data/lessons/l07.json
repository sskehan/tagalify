    },
    {
     "type": "vocab",
     "group": "mods",
     "title": "Modifiers"
    },
    {
     "type": "box",
     "kind": "remember",
     "title": "Remember",
     "items": [
      "-ng after a vowel, -g after n, na after any other consonant.",
      "The ligature goes after the FIRST word, whatever the order.",
      "Only the last of several adjectives takes a ligature.",
      "Repeat an adjective or adverb with a ligature for emphasis: malínaw na malínaw.",
      "No ligature after kung, or with a possessive pronoun after a noun, or with ka and kayó after an adjective."
     ]
    },
    {
     "type": "vocab",
     "group": "more",
     "title": "More words from this lesson"
    }
   ]
  }
