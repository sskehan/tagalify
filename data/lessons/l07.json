 "exercises": [
  {
   "type": "choice",
   "q": "Join malakí and báhay (big house).",
   "options": [
    "malakíng báhay",
    "malakí na báhay",
    "malakíg báhay"
   ],
   "answer": "malakíng báhay",
   "explain": "Malakí ends in a vowel, so add -ng."
  },
  {
   "type": "choice",
   "q": "Join mayáman and laláki (rich man).",
   "options": [
    "mayámang laláki",
    "mayáman na laláki",
    "mayámanng laláki"
   ],
   "answer": "mayámang laláki",
   "explain": "Mayáman ends in n, so add just -g."
  },
  {
   "type": "choice",
   "q": "Join maásim and manggà (sour mango).",
   "options": [
    "maásim na manggà",
    "maásiming manggà",
    "maásimng manggà"
   ],
   "answer": "maásim na manggà",
   "explain": "Maásim ends in m, a consonant other than n, so use na."
  },
  {
   "type": "choice",
   "q": "Join tahímik and batà (quiet child).",
   "options": [
    "tahímik na batà",
    "tahímiking batà",
    "tahímik batà"
   ],
   "answer": "tahímik na batà",
   "explain": "Tahímik ends in k, so use na."
  },
  {
   "type": "choice",
   "q": "Which is correct for \"strong wind\" with hángin first?",
   "options": [
    "hánging malakás",
    "hángin na malakás",
    "hángining malakás"
   ],
   "answer": "hánging malakás",
   "explain": "Hángin ends in n, so add -g."
  },
  {
   "type": "choice",
   "q": "Which is correct for \"rich man\" with laláki first?",
   "options": [
    "laláking mayáman",
    "laláki na mayáman",
    "lalákig mayáman"
   ],
   "answer": "laláking mayáman",
   "explain": "Laláki ends in a vowel, so add -ng."
  },
  {
   "type": "choice",
   "q": "A word ending in the consonant n takes which ligature?",
   "options": [
    "-g",
    "-ng",
    "na"
   ],
   "answer": "-g",
   "explain": "mayáman + -g = mayámang."
  },
  {
   "type": "choice",
   "q": "A word ending in a vowel takes which ligature?",
   "options": [
    "-ng",
    "-g",
    "na"
   ],
   "answer": "-ng",
   "explain": "malakí + -ng = malakíng."
  },
  {
   "type": "choice",
   "q": "Do ligatures have a meaning of their own?",
   "options": [
    "No",
    "Yes, they mean and"
   ],
   "answer": "No",
   "explain": "They only show that the two words are closely related."
  },
  {
   "type": "choice",
   "q": "With several adjectives before a noun, which one takes the ligature?",
   "options": [
    "Only the last one",
    "Every one",
    "Only the first one"
   ],
   "answer": "Only the last one",
   "explain": "mabaít at masunúring áso."
  },
  {
   "type": "choice",
   "q": "Which of these needs no ligature?",
   "options": [
    "Marúnong ka.",
    "malakí báhay",
    "tahímik batà"
   ],
   "answer": "Marúnong ka.",
   "explain": "An adjective + nominative pronoun (ka, kayó) takes no ligature."
  },
  {
   "type": "choice",
   "q": "Which word does NOT need a ligature after it?",
   "options": [
    "kung",
    "samantála",
    "sakáli"
   ],
   "answer": "kung",
   "explain": "Kung walâ pa ako, máuna na kayó."
  },
  {
   "type": "choice",
   "q": "What does \"Malínaw na malínaw ang útos niya\" mean?",
   "options": [
    "His/her command is very clear.",
    "His/her command is not clear.",
    "His/her command is a little clear."
   ],
   "answer": "His/her command is very clear.",
   "explain": "Repeating the adjective with a ligature makes a superlative."
  },
  {
   "type": "choice",
   "q": "Is \"batàng babáe\" the same as \"babáeng batà\"?",
   "options": [
    "Yes, both mean young girl",
    "No, they mean different things"
   ],
   "answer": "Yes, both mean young girl",
   "explain": "Changing the order does not change the meaning."
  },
  {
   "type": "choice",
   "q": "Why is there no ligature in \"aklát ko\"?",
   "options": [
    "A possessive pronoun after a noun takes none",
    "Aklát ends in a vowel",
