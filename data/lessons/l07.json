 "exercises": [
  {
   "type": "choice",
   "q": "Join malaki and bahay (big house).",
   "options": [
    "malaking bahay",
    "malaki na bahay",
    "malakig bahay"
   ],
   "answer": "malaking bahay",
   "explain": "Malaki ends in a vowel, so use -ng."
  },
  {
   "type": "choice",
   "q": "Join mayaman and lalaki (rich man).",
   "options": [
    "mayamang lalaki",
    "mayaman na lalaki",
    "mayamanng lalaki"
   ],
   "answer": "mayamang lalaki",
   "explain": "Mayaman ends in n, so add just -g."
  },
  {
   "type": "choice",
   "q": "Join mabait and bata (kind child).",
   "options": [
    "mabait na bata",
    "mabaiting bata",
    "mabaitng bata"
   ],
   "answer": "mabait na bata",
   "explain": "Mabait ends in t, a consonant other than n, so use na."
  },
  {
   "type": "choice",
   "q": "Join sariwa and isda (fresh fish).",
   "options": [
    "sariwang isda",
    "sariwa na isda",
    "sariwag isda"
   ],
   "answer": "sariwang isda",
   "explain": "Sariwa ends in a vowel."
  },
  {
   "type": "choice",
   "q": "Join matamis and kape (sweet coffee).",
   "options": [
    "matamis na kape",
    "matamising kape",
    "matamisng kape"
   ],
   "answer": "matamis na kape",
   "explain": "Matamis ends in s, so use na."
  },
  {
   "type": "choice",
   "q": "Which is correct for \"a cold wind\" with hangin first?",
   "options": [
    "hanging malamig",
    "hangin na malamig",
    "hangining malamig"
