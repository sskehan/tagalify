 "exercises": [
  {
   "type": "choice",
   "q": "How many letters were in the older Tagalog alphabet?",
   "options": [
    "20",
    "26",
    "28"
   ],
   "answer": "20",
   "explain": "Five vowels and fifteen consonants, with ng counted as one letter."
  },
  {
   "type": "choice",
   "q": "The eight added letters (c, f, j, ñ, q, v, x, z) are used mainly for…",
   "options": [
    "Names and borrowed words",
    "Everyday Tagalog words",
    "Numbers"
   ],
   "answer": "Names and borrowed words",
   "explain": "Native Tagalog words rarely need them."
  },
  {
   "type": "choice",
   "q": "What does Tagalog ng sound like?",
   "options": [
    "The end of the word \"sing\"",
    "An n followed by a separate g",
    "A hard k"
   ],
   "answer": "The end of the word \"sing\"",
   "explain": "It is one nasal sound, and it can start a word."
  },
  {
   "type": "choice",
   "q": "The letter ñ sounds like…",
   "options": [
    "n + y",
    "m + y",
    "a hard g"
   ],
   "answer": "n + y",
   "explain": "Niño sounds like nin-yo."
  },
  {
   "type": "choice",
   "q": "How is the Tagalog r pronounced?",
   "options": [
    "A quick tap of the tongue",
    "Like the English r",
    "A long rolled trill"
   ],
   "answer": "A quick tap of the tongue",
   "explain": "Think of the tt in American butter."
  },
  {
   "type": "choice",
   "q": "Which of these is a diphthong (one smooth glide)?",
   "options": [
    "oy",
    "ko",
    "ma"
   ],
   "answer": "oy",
   "explain": "The six diphthongs are ay, aw, ey, iw, oy and uy."
  },
  {
   "type": "choice",
   "q": "Spanish \"calle\" becomes which Tagalog word?",
   "options": [
    "kalye",
    "kalle",
    "calye"
   ],
   "answer": "kalye",
   "explain": "ll becomes ly, and hard c becomes k."
  },
  {
   "type": "choice",
   "q": "English \"quality\" becomes…",
   "options": [
    "kwaliti",
    "kuality",
    "kualidad"
   ],
   "answer": "kwaliti",
   "explain": "qu becomes kw."
  },
  {
   "type": "choice",
   "q": "English \"driver\" becomes…",
   "options": [
    "drayber",
    "driber",
    "draiver"
   ],
   "answer": "drayber",
   "explain": "A long i becomes ay, and v becomes b."
  },
  {
   "type": "choice",
   "q": "English \"school\" becomes…",
   "options": [
    "iskul",
    "eskwela",
    "skul"
   ],
   "answer": "iskul",
   "explain": "A word starting with s plus a consonant gets an i in front."
  },
  {
   "type": "listen",
   "tl": "kape",
   "options": [
    "coffee",
    "car",
    "paper"
   ],
   "answer": "coffee",
   "explain": "Kape is coffee, from Spanish café."
  },
  {
   "type": "listen",
