       "to become quiet (or to be quiet)"
      ],
      [
       "[[magíng|pred]] [[mayáman|pred]]",
       "to become rich (or to be rich)"
      ],
      [
       "[[magíng|pred]] [[bulág|pred]]",
       "to become blind (or to be blind)"
      ]
     ],
     "title": "Magíng phrases"
    }
   ]
  },
  {
   "title": "Forming phrases with magíng",
   "blocks": [
    {
     "type": "p",
     "t": "Take a root such as **baít** (kindness). Attach **ma-** to the root to make the adjective **mabaít**, and put a form of magíng in front of it. Only magíng changes for the tense."
    },
    {
     "type": "table",
     "head": [
      "Form",
      "Phrase",
      "How it is made",
      "Meaning"
     ],
     "rows": [
      [
       "Root",
       "[[baít|noun]]",
       "",
       "kindness"
      ],
      [
       "Infinitive",
       "[[magíng mabaít|pred]]",
       "magíng + ma- attached to root",
       "to be kind"
      ],
      [
       "Imperative",
       "[[magíng mabaít|pred]]",
       "magíng + ma- attached to root",
       "Be kind!"
      ],
      [
       "Past",
       "[[nagíng mabaít|pred]]",
       "magíng becomes nagíng + ma- attached to root",
       "became kind"
      ],
      [
       "Present",
       "[[nagíging mabaít|pred]]",
       "magíng becomes nagíging + ma- attached to root",
       "become kind"
      ],
      [
       "Future",
       "[[magíging mabaít|pred]]",
       "magíng becomes magíging + ma- attached to root",
       "will become kind"
      ]
     ],
     "title": "Magíng with baít"
    },
    {
     "type": "box",
     "kind": "tip",
     "title": "Spot the tense",
     "items": [
      "**m** → **n** for the past and present: magíng → **n**agíng, **n**agíging.",
      "The present and future repeat **gi**: na**gí**ging, ma**gí**ging.",
      "The infinitive and the imperative look the same: magíng."
     ]
    },
    {
     "type": "vocab",
     "group": "maging",
     "title": "The forms of magíng"
    }
   ]
  },
