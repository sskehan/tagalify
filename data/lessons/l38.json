 "exercises": [
  {
   "type": "choice",
   "q": "What is a gerund?",
   "options": [
    "A noun made from a verb",
    "A verb in the past tense",
    "An adjective made from a noun"
   ],
   "answer": "A noun made from a verb",
   "explain": "A gerund is a verbal noun, like writing in Writing calms my mind."
  },
  {
   "type": "choice",
   "q": "In \"Writing calms my mind\", how can you prove writing is a gerund?",
   "options": [
    "A pronoun can replace it: It calms my mind",
    "It ends in a vowel",
    "It comes after the verb"
   ],
   "answer": "A pronoun can replace it: It calms my mind",
   "explain": "Only a noun can be replaced by a pronoun."
  },
  {
   "type": "choice",
   "q": "Which article goes in front of a plural verbal noun?",
   "options": [
    "ang mga",
    "si",
    "niná"
   ],
   "answer": "ang mga",
   "explain": "Ang (singular) or ang mga (plural) is used to form gerunds."
  },
  {
   "type": "choice",
   "q": "How is a noun formed from an -um- verb?",
   "options": [
    "pag- + root",
    "pag- + duplicated first syllable + root",
    "pagka- + root"
   ],
   "answer": "pag- + root",
   "explain": "umalís → pag-alís, lumakad → paglakad."
  },
  {
   "type": "choice",
   "q": "How is a noun formed from a mag- verb?",
   "options": [
    "pag- + duplicated first syllable + root",
    "pag- + root",
    "paki- + root"
   ],
   "answer": "pag- + duplicated first syllable + root",
   "explain": "maglarô → paglalarô, magtaním → pagtataním."
  },
  {
   "type": "choice",
   "q": "How is a noun formed from a paki- verb?",
   "options": [
    "paki- + duplicated last syllable of paki- + root",
    "pag- + root",
    "pagka- + root"
   ],
   "answer": "paki- + duplicated last syllable of paki- + root",
   "explain": "pakisúlat → pakíkisúlat."
  },
  {
   "type": "choice",
   "q": "For ma- verbs, when do you use pagka- instead of pag-?",
   "options": [
    "For feelings",
    "For actions",
    "For plural nouns"
   ],
   "answer": "For feelings",
   "explain": "pagligò (bathing, an action) but pagkagálit (being angry, a feeling)."
  },
