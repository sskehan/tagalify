 "exercises": [
  {
   "type": "choice",
   "q": "Why might a foreigner learn Tagalog food names before visiting a wet market?",
   "options": [
    "Many vendors do not know the English names",
    "Wet markets only sell imported food",
    "Supermarkets are cheaper"
   ],
   "answer": "Many vendors do not know the English names",
   "explain": "Wet markets are cheaper and more varied, but vendors may only know the local names."
  },
  {
   "type": "choice",
   "q": "Which of these is usually known by its English name?",
   "options": [
    "cauliflower",
    "eggplant",
    "milkfish"
   ],
   "answer": "cauliflower",
   "explain": "Carrot, cauliflower, greenshells and yellow fin tuna keep their English names. Eggplant is talóng; milkfish is bangús."
  },
  {
   "type": "choice",
   "q": "What is talóng?",
   "options": [
    "eggplant",
    "tomato",
    "cabbage"
   ],
   "answer": "eggplant",
   "explain": "Tomato is kamátis; cabbage is repolyo."
  },
  {
   "type": "choice",
   "q": "Which word means onion?",
   "options": [
    "sibúyas",
    "bawang",
    "kintsáy"
   ],
   "answer": "sibúyas",
   "explain": "Bawang is garlic; kintsáy is Chinese celery."
  },
  {
   "type": "choice",
   "q": "How do you say sweet potato?",
   "options": [
    "kamóte",
    "kamóteng káhoy",
    "patátas"
   ],
   "answer": "kamóte",
   "explain": "Kamóteng káhoy is cassava; patátas is potato."
  },
  {
   "type": "choice",
   "q": "Which is the freshwater catfish?",
   "options": [
    "hitò",
    "kandulì",
    "tilápia"
   ],
   "answer": "hitò",
   "explain": "Kandulì is the saltwater catfish."
  },
  {
   "type": "choice",
   "q": "What is bangús?",
   "options": [
    "milkfish",
    "mussel",
    "squid"
   ],
   "answer": "milkfish",
   "explain": "Mussel is tahóng; squid is pusít."
  },
  {
   "type": "choice",
   "q": "Which word means prawn?",
   "options": [
    "sugpô",
    "alamáng",
    "híbi"
   ],
   "answer": "sugpô",
   "explain": "Alamáng is small shrimps; híbi is dried shrimp."
  },
  {
   "type": "choice",
   "q": "What does karné ng baboy mean?",
   "options": [
    "pork",
    "beef",
    "ham"
