     "rows": [
      {
       "label": "Pattern",
       "chips": [
        {
         "t": "Ang",
         "r": "marker"
        },
        {
         "t": "báhay",
         "r": "noun"
        },
        {
         "t": "ay",
         "r": "ay"
        },
        {
         "t": "malakí",
         "r": "pred"
        }
       ]
      }
     ],
     "note": "Ay may become 'y after a vowel: Ako'y, Itó'y."
    },
    {
     "type": "p",
     "t": "To invert: put the predicate first, leave out ay, keep the article with the subject. With a plural subject, start with **mga**, not ang mga: **Mga batà sina Peter at Mary.**"
    }
   ]
